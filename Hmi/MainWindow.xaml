<Window x:Class="Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:ctl="clr-namespace:Hmi.Controls"
        Title="RobotSimulation" Height="760" Width="1160" MinHeight="720" MinWidth="1160">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveScreenshot_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Import Model" Click="BtnOpenFolder_Click"/>
                <MenuItem Header="Save Screenshot..." Command="ApplicationCommands.Save"/>
                <MenuItem Header="Clear Scene" Click="BtnClear_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Name="MenuIso" Header="ISO" IsCheckable="True" IsChecked="True" Click="BtnIso_Click"/>
                <MenuItem Name="MenuTop" Header="Top" IsCheckable="True" Click="BtnTop_Click"/>
                <Separator/>
                <MenuItem Header="Fit All" Click="BtnFitAll_Click"/>
                <Separator/>
                <MenuItem Header="TCP Trail">
                    <MenuItem Name="MenuTrailOff"      Header="Off"                       IsCheckable="True" IsChecked="True" Click="MenuTrailMode_Click" Tag="0"/>
                    <MenuItem Name="MenuTrailLine"     Header="TCP Path"                  IsCheckable="True"                   Click="MenuTrailMode_Click" Tag="1"/>
                    <MenuItem Name="MenuTrailFrames"   Header="TCP Path + Frames"         IsCheckable="True"                   Click="MenuTrailMode_Click" Tag="2"/>
                    <Separator/>
                    <MenuItem Header="Color">
                        <MenuItem Name="MenuTrailColorYellow"  Header="Yellow"  IsCheckable="True" IsChecked="True" Click="MenuTrailColor_Click" Tag="255,255,0"/>
                        <MenuItem Name="MenuTrailColorCyan"    Header="Cyan"    IsCheckable="True"                  Click="MenuTrailColor_Click" Tag="0,255,255"/>
                        <MenuItem Name="MenuTrailColorMagenta" Header="Magenta" IsCheckable="True"                  Click="MenuTrailColor_Click" Tag="255,0,255"/>
                        <MenuItem Name="MenuTrailColorGreen"   Header="Green"   IsCheckable="True"                  Click="MenuTrailColor_Click" Tag="0,255,0"/>
                        <MenuItem Name="MenuTrailColorRed"     Header="Red"     IsCheckable="True"                  Click="MenuTrailColor_Click" Tag="255,64,64"/>
                        <MenuItem Name="MenuTrailColorWhite"   Header="White"   IsCheckable="True"                  Click="MenuTrailColor_Click" Tag="255,255,255"/>
                    </MenuItem>
                    <MenuItem Header="Max Points">
                        <MenuItem Name="MenuTrailMax500"   Header="500"    IsCheckable="True"                  Click="MenuTrailMaxPoints_Click" Tag="500"/>
                        <MenuItem Name="MenuTrailMax1000"  Header="1000"   IsCheckable="True"                  Click="MenuTrailMaxPoints_Click" Tag="1000"/>
                        <MenuItem Name="MenuTrailMax2000"  Header="2000"   IsCheckable="True" IsChecked="True" Click="MenuTrailMaxPoints_Click" Tag="2000"/>
                        <MenuItem Name="MenuTrailMax5000"  Header="5000"   IsCheckable="True"                  Click="MenuTrailMaxPoints_Click" Tag="5000"/>
                        <MenuItem Name="MenuTrailMax10000" Header="10000"  IsCheckable="True"                  Click="MenuTrailMaxPoints_Click" Tag="10000"/>
                    </MenuItem>
                    <MenuItem Header="Frame Stride">
                        <MenuItem Name="MenuTrailStride10"  Header="10"   IsCheckable="True"                  Click="MenuTrailStride_Click" Tag="10"/>
                        <MenuItem Name="MenuTrailStride25"  Header="25"   IsCheckable="True"                  Click="MenuTrailStride_Click" Tag="25"/>
                        <MenuItem Name="MenuTrailStride50"  Header="50"   IsCheckable="True" IsChecked="True" Click="MenuTrailStride_Click" Tag="50"/>
                        <MenuItem Name="MenuTrailStride100" Header="100"  IsCheckable="True"                  Click="MenuTrailStride_Click" Tag="100"/>
                        <MenuItem Name="MenuTrailStride200" Header="200"  IsCheckable="True"                  Click="MenuTrailStride_Click" Tag="200"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Clear Trail" Click="MenuTrailClear_Click"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar Name="StatusBarMain" DockPanel.Dock="Bottom" Background="#4CAF50">
            <StatusBarItem HorizontalContentAlignment="Center" HorizontalAlignment="Stretch">
                <TextBlock Name="TxtStatus" TextWrapping="Wrap" Foreground="White" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#F3F4F6">
                <Grid.Resources>
                    <Style TargetType="Button" x:Key="JogBtn">
                        <Setter Property="Width" Value="44"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="3,0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" Margin="8" SelectionChanged="ModeTab_SelectionChanged" Name="ModeTabs">
                    <!-- ====== Manual Mode (JOG via press-and-hold buttons) ====== -->
                    <TabItem Header="Manual">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="Joint JOG" Margin="0,0,0,4">
                                        <Grid Margin="6,2" HorizontalAlignment="Left">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="J1"/>
                                            <Button    Grid.Row="0" Grid.Column="1" Content="-" Tag="0:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="0" Grid.Column="2" Content="+" Tag="0:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="J2"/>
                                            <Button    Grid.Row="1" Grid.Column="1" Content="-" Tag="1:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="1" Grid.Column="2" Content="+" Tag="1:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="J3"/>
                                            <Button    Grid.Row="2" Grid.Column="1" Content="-" Tag="2:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="2" Grid.Column="2" Content="+" Tag="2:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="J4"/>
                                            <Button    Grid.Row="3" Grid.Column="1" Content="-" Tag="3:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="3" Grid.Column="2" Content="+" Tag="3:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="J5"/>
                                            <Button    Grid.Row="4" Grid.Column="1" Content="-" Tag="4:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="4" Grid.Column="2" Content="+" Tag="4:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="J6"/>
                                            <Button    Grid.Row="5" Grid.Column="1" Content="-" Tag="5:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="5" Grid.Column="2" Content="+" Tag="5:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                        </Grid>
                                    </GroupBox>
                            <GroupBox Grid.Row="1" Header="World JOG" Margin="0,0,0,0">
                                        <Grid Margin="6,2" HorizontalAlignment="Left">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="X"/>
                                            <Button    Grid.Row="0" Grid.Column="1" Content="-" Tag="W:0:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="0" Grid.Column="2" Content="+" Tag="W:0:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10" Text="mm"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Y"/>
                                            <Button    Grid.Row="1" Grid.Column="1" Content="-" Tag="W:1:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="1" Grid.Column="2" Content="+" Tag="W:1:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10" Text="mm"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Z"/>
                                            <Button    Grid.Row="2" Grid.Column="1" Content="-" Tag="W:2:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="2" Grid.Column="2" Content="+" Tag="W:2:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10" Text="mm"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="A"/>
                                            <Button    Grid.Row="3" Grid.Column="1" Content="-" Tag="W:3:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="3" Grid.Column="2" Content="+" Tag="W:3:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <TextBlock Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10" Text="°"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="B"/>
                                            <Button    Grid.Row="4" Grid.Column="1" Content="-" Tag="W:4:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="4" Grid.Column="2" Content="+" Tag="W:4:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <TextBlock Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10" Text="°"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="C"/>
                                            <Button    Grid.Row="5" Grid.Column="1" Content="-" Tag="W:5:-1" Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <Button    Grid.Row="5" Grid.Column="2" Content="+" Tag="W:5:1"  Style="{StaticResource JogBtn}" PreviewMouseLeftButtonDown="JogBtn_Down" PreviewMouseLeftButtonUp="JogBtn_Up" MouseLeave="JogBtn_Leave"/>
                                            <TextBlock Grid.Row="5" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10" Text="°"/>
                                        </Grid>
                                </GroupBox>

                                <Button Grid.Row="3" Content="Reset to Home" Padding="8,6" FontWeight="SemiBold" Click="BtnResetHome_Click"/>
                        </Grid>
                    </TabItem>

                    <!-- ====== Auto Mode (TCP pose input) ====== -->
                    <TabItem Header="Auto">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <GroupBox Header="Target TCP Pose" Margin="0,0,0,12">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X"  VerticalAlignment="Center"/>
                                        <TextBox  Grid.Row="0" Grid.Column="1" Name="TxtPoseX"  Text="0.000" Margin="4" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y"  VerticalAlignment="Center"/>
                                        <TextBox  Grid.Row="1" Grid.Column="1" Name="TxtPoseY"  Text="0.000" Margin="4" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Z"  VerticalAlignment="Center"/>
                                        <TextBox  Grid.Row="2" Grid.Column="1" Name="TxtPoseZ"  Text="0.000" Margin="4" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="A" VerticalAlignment="Center" ToolTip="Rotation about X axis"/>
                                        <TextBox  Grid.Row="3" Grid.Column="1" Name="TxtPoseA" Text="0.000" Margin="4" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="°"  VerticalAlignment="Center" Margin="4,0,0,0"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="B" VerticalAlignment="Center" ToolTip="Rotation about Y axis"/>
                                        <TextBox  Grid.Row="4" Grid.Column="1" Name="TxtPoseB" Text="0.000" Margin="4" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="°"  VerticalAlignment="Center" Margin="4,0,0,0"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="C" VerticalAlignment="Center" ToolTip="Rotation about Z axis"/>
                                        <TextBox  Grid.Row="5" Grid.Column="1" Name="TxtPoseC" Text="0.000" Margin="4" FontFamily="Consolas"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="°"  VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </GroupBox>

                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="Copy Current" Margin="0,0,4,4" Padding="8,4" Click="BtnCopyCurrentPose_Click"/>
                                    <Button Grid.Row="0" Grid.Column="1" Name="BtnStopMotion" Content="Stop" Margin="4,0,0,4" Padding="8,4" Click="BtnStopMotion_Click" IsEnabled="False"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="MoveL"        Margin="0,4,4,0" Padding="8,4" Click="BtnMoveL_Click"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="MoveJ"        Margin="4,4,0,0" Padding="8,4" Click="BtnMoveJ_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ====== Drag Mode ====== -->
                    <TabItem Header="Drag">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <GroupBox Header="Drag Teach" Margin="0,0,0,12">
                                    <StackPanel Margin="10">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="Drag mode: use the mouse to drag the TCP or a joint to pose the robot in real time."/>
                                        <ToggleButton Name="TglDragEnable" Content="Enable Drag" Padding="8,4" Margin="0,0,0,8"
                                                      Checked="TglDragEnable_Changed" Unchecked="TglDragEnable_Changed"/>
                                        <TextBlock Text="Drag Target:" Margin="0,4,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Name="RbDragTcp"   Content="TCP"   IsChecked="True" Margin="0,0,12,0" GroupName="DragTarget" Checked="RbDragTarget_Checked"/>
                                            <RadioButton Name="RbDragJoint" Content="Joint"                  GroupName="DragTarget" Checked="RbDragTarget_Checked"/>
                                        </StackPanel>
                                        <TextBlock Text="Gizmo:" Margin="0,8,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Name="RbGizmoTranslate" Content="Translate" IsChecked="True" Margin="0,0,12,0" GroupName="Gizmo" Checked="RbGizmoMode_Checked"/>
                                            <RadioButton Name="RbGizmoRotate"    Content="Rotate"                     GroupName="Gizmo" Checked="RbGizmoMode_Checked"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                <ctl:StatusDashboard Grid.Row="1" x:Name="Dashboard" Margin="12,0,12,12"/>
            </Grid>

            <!-- Right column: 3D viewport on top, horizontal GridSplitter, Teach pendant
                 docked at the bottom. Teach used to live inside the left ModeTabs, but
                 the JOG→Teach round-trip forced constant tab switching. Keeping the
                 pendant always visible lets the operator pose the robot on the left,
                 hit Add on the bottom, and see the new waypoint immediately. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260" MinHeight="140"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="8,8,8,4" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1" Background="#2E2E2E">
                    <wfi:WindowsFormsHost Name="WinFormsHost" Margin="0">
                        <wf:Panel x:Name="DesignPlaceholder" BackColor="#2E2E2E" />
                    </wfi:WindowsFormsHost>
                </Border>

                <GridSplitter Grid.Row="1" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="#D1D5DB"
                              ShowsPreview="True"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"/>

                <Border Grid.Row="2" Margin="8,4,8,8" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1" Background="White">
                    <ctl:WaypointGrid x:Name="TeachGrid" Margin="6"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
